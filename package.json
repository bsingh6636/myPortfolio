{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "lucide-react": "^0.539.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env GENERATE_SOURCEMAP=false react-scripts build && node scripts/prerender.cjs",
    "lint": "eslint . --ext .js,.jsx --max-warnings 0",
    "lint:fix": "npm run lint -- --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
